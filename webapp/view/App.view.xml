<mvc:View
	controllerName="zaudgpms.audhatham.com.controller.App"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:tnt="sap.tnt"
	height="100%"
	displayBlock="true">

	<App id="idRootApp" initialPage="idMainPage">
		<pages>

			<!-- ─── LOGIN PAGE ─── -->
			<Page id="idLoginPage" showHeader="false" enableScrolling="false">
				<NavContainer id="idLoginNavContainer"/>
			</Page>

			<!-- ─── MAIN APP PAGE ─── -->
			<Page id="idMainPage" showHeader="false" enableScrolling="false">
				<tnt:ToolPage id="idToolPage">
					<tnt:header>
						<tnt:ToolHeader class="gpmsShellBar">
							<Button
								icon="sap-icon://menu2"
								type="Transparent"
								press=".onSideNavButtonPress">
								<layoutData>
									<OverflowToolbarLayoutData priority="NeverOverflow"/>
								</layoutData>
							</Button>
							<Image src="assets/img/logo.png" height="48px" class="sapUiTinyMarginBegin"/>
							<ToolbarSpacer/>
							<Text id="idWelcomeText" class="gpmsWelcomeText sapUiTinyMarginEnd"/>
							<Avatar id="idUserAvatar" displaySize="XS" class="sapUiTinyMarginEnd"/>
							<Button
								icon="sap-icon://log"
								type="Transparent"
								tooltip="Logout"
								press=".onButtonLogoutPress">
								<layoutData>
									<OverflowToolbarLayoutData priority="NeverOverflow"/>
								</layoutData>
							</Button>
						</tnt:ToolHeader>
					</tnt:header>
					<tnt:sideContent>
						<tnt:SideNavigation id="idSideNav" selectedKey="home" itemSelect=".onItemSelect" class="gpmsSideNav">
							<tnt:NavigationList>
								<tnt:NavigationListItem text="Dashboard"        icon="sap-icon://home"         key="home"/>
								<tnt:NavigationListItem text="Create Gate Pass" icon="sap-icon://add-document" key="GatePassCreation"/>
								<tnt:NavigationListItem text="Gate Pass List"   icon="sap-icon://list"         key="GatePassList"/>
							</tnt:NavigationList>
							<tnt:fixedItem>
								<tnt:NavigationList>
									<tnt:NavigationListItem text="Settings" icon="sap-icon://settings" key="settings"/>
								</tnt:NavigationList>
							</tnt:fixedItem>
						</tnt:SideNavigation>
					</tnt:sideContent>
					<tnt:mainContents>
						<App id="idMainApp"/>
					</tnt:mainContents>
				</tnt:ToolPage>
			</Page>

		</pages>
	</App>

</mvc:View>
