<mvc:View
	controllerName="zaudgpms.audhatham.com.controller.GatePassCreation"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:form="sap.ui.layout.form"
	xmlns:core="sap.ui.core"
	xmlns:unified="sap.ui.unified"
	xmlns:layout="sap.ui.layout"
	height="100%">
	<Page
		id="gatePassCreationPage"
		title="{= ${gp>/GatePassNo} ? 'Gate Pass Details - ' + ${gp>/GatePassNo} : 'Create Gate Pass' }"
		showNavButton="{= !${gp>/editable} }"
		navButtonPress=".onNavBackToList"
		class="gpmsPage">
		<content>
			<VBox class="gpmsContentWrapper sapUiMediumMargin">

				<!-- ─── SECTION 1 · Control Parameters (Checkboxes) ──── -->
				<Panel class="gpmsSection" expandable="false">
					<headerToolbar>
						<Toolbar class="gpmsSectionBar gpmsAccentBar">
							<core:Icon src="sap-icon://settings" class="gpmsSectionBarIcon"/>
							<Label text="Control Parameters" class="gpmsSectionBarLabel"/>
						</Toolbar>
					</headerToolbar>
					<layout:Grid defaultSpan="XL3 L3 M6 S12" vSpacing="1" hSpacing="1">

						<!-- Direction -->
						<VBox>
							<Label text="Direction" required="true" class="gpmsFieldLabel"/>
							<CheckBox
								text="Inward"
								selected="{gp>/IsInward}"
								select=".onInwardChange"
								editable="{gp>/editable}"
								class="sapUiTinyMarginTop"/>
							<CheckBox
								text="Outward"
								selected="{gp>/IsOutward}"
								select=".onOutwardChange"
								editable="{gp>/editable}"
								class="sapUiTinyMarginTop"/>
						</VBox>

						<!-- Gate Pass Type -->
						<VBox>
							<Label text="Gate Pass Type" required="true" class="gpmsFieldLabel"/>
							<CheckBox
								text="Returnable (RGP)"
								selected="{gp>/IsReturnable}"
								select=".onReturnableChange"
								editable="{gp>/editable}"
								class="sapUiTinyMarginTop"/>
							<CheckBox
								text="Non-Returnable (NRGP)"
								selected="{gp>/IsNonReturnable}"
								select=".onNonReturnableChange"
								editable="{gp>/editable}"
								class="sapUiTinyMarginTop"/>
						</VBox>

						<!-- Entry Mode -->
						<VBox>
							<Label text="Entry Mode" class="gpmsFieldLabel"/>
							<CheckBox
								text="Manual Entry"
								selected="{gp>/IsManual}"
								select=".onManualChange"
								editable="{gp>/editable}"
								class="sapUiTinyMarginTop"/>
						</VBox>

						<!-- Document References -->
						<VBox>
							<Label text="Document Reference" class="gpmsFieldLabel"/>
							<CheckBox
								text="PO Number"
								selected="{gp>/HasPONumber}"
								select=".onPONumberCheckBoxSelect"
								editable="{gp>/editable}"
								class="sapUiTinyMarginTop"/>
							<CheckBox
								text="Customer Invoice No."
								selected="{gp>/HasCustomerInvoice}"
								select=".onCustomerInvoiceNoCheckBoxSelect"
								editable="{gp>/editable}"
								class="sapUiTinyMarginTop"/>
						</VBox>

						<!-- Category — toggles between Inward and Outward -->
						<VBox>
							<VBox visible="{gp>/IsInward}">
								<Label text="Inward Category" class="gpmsFieldLabel"/>
								<Select
									selectedKey="{gp>/InwardCategory}"
									editable="{gp>/editable}"
									class="gpmsFieldInput"
									width="100%">
									<core:Item key="01-Purchase order" text="01-Purchase order"/>
									<core:Item key="02-Customer return" text="02-Customer return"/>
									<core:Item key="03-Samples" text="03-Samples"/>
									<core:Item key="04-Others" text="04-Others"/>
								</Select>
							</VBox>
							<VBox visible="{gp>/IsOutward}">
								<Label text="Outward Category" class="gpmsFieldLabel"/>
								<Select
									selectedKey="{gp>/OutwardCategory}"
									editable="{gp>/editable}"
									class="gpmsFieldInput"
									width="100%">
									<core:Item key="01-Service maintenance" text="01-Service maintenance"/>
									<core:Item key="02-Customer sales" text="02-Customer sales"/>
									<core:Item key="03-Vendor Returns" text="03-Vendor Returns"/>
									<core:Item key="04-Others" text="04-Others"/>
								</Select>
							</VBox>
						</VBox>

					</layout:Grid>
				</Panel>

				<!-- ─── SECTION 2 · Header Information ────────────────── -->
				<Panel class="gpmsSection" expandable="false">
					<headerToolbar>
						<Toolbar class="gpmsSectionBar">
							<core:Icon src="sap-icon://document-text" class="gpmsSectionBarIcon"/>
							<Label text="Header Information" class="gpmsSectionBarLabel"/>
							<ToolbarSpacer/>
							<ObjectStatus
								text="{= ${gp>/GatePassNo} ? ${gp>/Status} : 'Draft' }"
								state="{= ${gp>/Status} === 'Approved' ? 'Success' : 'Warning' }"
								class="gpmsBadge"/>
						</Toolbar>
					</headerToolbar>
					<layout:Grid defaultSpan="XL12 L12 M12 S12" vSpacing="1" hSpacing="1">

						<!-- Left-Side Fields Container (9 columns out of 12) -->
						<VBox>
							<layoutData>
								<layout:GridData span="XL9 L9 M8 S12"/>
							</layoutData>
							<layout:Grid defaultSpan="XL12 L12 M12 S12" vSpacing="1" hSpacing="1" class="gpmsInnerGrid">

								<!-- Row 1: Plant Code & PO / Customer Invoice -->
								<VBox>
									<layoutData>
										<layout:GridData span="XL4 L4 M6 S12"/>
									</layoutData>
									<Label text="Plant Code" required="true" class="gpmsFieldLabel"/>
									<ComboBox
										id="plantSelect"
										selectedKey="{gp>/Plant}"
										items="{path: 'plants>/results'}"
										selectionChange=".onPlantChange"
										change=".onComboBoxPlantChange"
										placeholder="Select Plant code..."
										editable="{gp>/editable}"
										class="gpmsFieldInput"
										width="100%">
										<core:ListItem key="{plants>Plant}" text="{plants>Plant} - {plants>PlantName}"/>
									</ComboBox>
								</VBox>

								<VBox visible="{= (${gp>/HasCustomerInvoice} || (${gp>/HasPONumber} &amp;&amp; !${gp>/IsManual})) }">
									<layoutData>
										<layout:GridData span="XL4 L4 M6 S12"/>
									</layoutData>
									<!-- PO Number: visible only when HasPONumber is checked and not Manual mode -->
									<VBox visible="{= !${gp>/IsManual} &amp;&amp; ${gp>/HasPONumber} }">
										<Label text="PO Number" required="true" class="gpmsFieldLabel"/>
										<Input
											value="{gp>/PurchaseOrder}"
											placeholder="Select PO number..."
											editable="{gp>/editable}"
											showValueHelp="true"
											valueHelpRequest=".onPOValueHelp"
											submit=".onPurchaseOrderInputSubmit"
											change=".onPurchaseOrderInputChange"
											class="gpmsFieldInput"
											width="100%"/>
									</VBox>
									<!-- Customer Invoice: visible only when HasCustomerInvoice is checked -->
									<VBox visible="{gp>/HasCustomerInvoice}">
										<Label text="Customer Invoice Number" required="true" class="gpmsFieldLabel"/>
										<Input
											value="{gp>/CustomerInvoice}"
											placeholder="Enter Customer Invoice number..."
											editable="{gp>/editable}"
											showValueHelp="true"
											valueHelpRequest=".onInvoiceValueHelp"
											class="gpmsFieldInput"
											width="100%"/>
									</VBox>
								</VBox>

																				<!-- Row 2: Supplier / Customer (swaps based on Customer Invoice checkbox) -->
								<VBox visible="{= !${gp>/HasCustomerInvoice} }">
									<layoutData>
										<layout:GridData span="XL12 L12 M12 S12" linebreak="true"/>
									</layoutData>
									<layout:Grid defaultSpan="XL6 L6 M6 S12" vSpacing="0" hSpacing="1" class="gpmsInnerGrid">
										<!-- Supplier -->
										<VBox>
											<Label text="Supplier" required="true" class="gpmsFieldLabel"/>
											<ComboBox
												id="vendorInput" selectedKey="{gp>/vendor}" placeholder="Search supplier..." selectionChange=".onVendorSelect" editable="{gp>/editable}" class="gpmsFieldInput" width="100%" showSecondaryValues="true" filterSecondaryValues="true" items="{path: 'vendors>/results', templateShareable: false}">
												<core:ListItem key="{vendors>Vendor}" text="{vendors>Vendor}" additionalText="{vendors>VendorName}"/>
											</ComboBox>
										</VBox>
										<!-- Supplier Name -->
										<VBox>
											<Label text="Supplier Name" class="gpmsFieldLabel"/>
											<Input value="{gp>/vendorName}" editable="{gp>/editable}" class="gpmsFieldInput" width="100%"/>
										</VBox>
									</layout:Grid>
								</VBox>

								<!-- Row 2b: Customer (visible when Customer Invoice is checked) -->
								<VBox visible="{gp>/HasCustomerInvoice}">
									<layoutData>
										<layout:GridData span="XL12 L12 M12 S12" linebreak="true"/>
									</layoutData>
									<layout:Grid defaultSpan="XL6 L6 M6 S12" vSpacing="0" hSpacing="1" class="gpmsInnerGrid">
										<!-- Customer -->
										<VBox>
											<Label text="Customer" required="true" class="gpmsFieldLabel"/>
											<Input
												id="customerInput" value="{gp>/CustomerNo}" placeholder="Select customer..." editable="{gp>/editable}" showValueHelp="true" valueHelpRequest=".onCustomerInvoiceValueHelp" submit=".onCustomerInputSubmit" change=".onCustomerInputChange" class="gpmsFieldInput" width="100%"/>
										</VBox>
										<!-- Customer Name -->
										<VBox>
											<Label text="Customer Name" class="gpmsFieldLabel"/>
											<Input value="{gp>/CustomerName}" editable="false" class="gpmsFieldInput" width="100%"/>
										</VBox>
									</layout:Grid>
								</VBox>

								<!-- Row 3: Dispatch Details -->
								<VBox>
									<layoutData>
										<layout:GridData span="XL12 L12 M12 S12" linebreak="true"/>
									</layoutData>
									<layout:Grid defaultSpan="XL4 L4 M6 S12" vSpacing="0" hSpacing="1" class="gpmsInnerGrid">
										<!-- Mode of Dispatch -->
										<VBox>
											<Label text="Mode of Dispatch" class="gpmsFieldLabel"/>
											<Select
												selectedKey="{gp>/ModeOfDispatch}"
												editable="{gp>/editable}"
												class="gpmsFieldInput"
												width="100%">
												<core:Item key="Road" text="By Road"/>
												<core:Item key="Rail" text="By Rail"/>
												<core:Item key="Air" text="By Air"/>
												<core:Item key="Courier" text="By Courier"/>
											</Select>
										</VBox>
										<!-- Vehicle Number -->
										<VBox>
											<Label text="Vehicle Number" class="gpmsFieldLabel"/>
											<Input
												value="{gp>/VehicleNo}"
												placeholder="Enter Vehicle number..."
												editable="{gp>/editable}"
												class="gpmsFieldInput"
												width="100%"/>
										</VBox>
										<!-- Driver Name -->
										<VBox>
											<Label text="Driver Name" class="gpmsFieldLabel"/>
											<Input
												value="{gp>/DriverName}"
												placeholder="Enter Driver name..."
												editable="{gp>/editable}"
												class="gpmsFieldInput"
												width="100%"/>
										</VBox>
									</layout:Grid>
								</VBox>

								<!-- Row 4: Comments / Remarks -->
								<VBox>
									<layoutData>
										<layout:GridData span="XL12 L12 M12 S12" linebreak="true"/>
									</layoutData>
									<Label text="Comments / Remarks (Max 100 Char)" class="gpmsFieldLabel"/>
									<TextArea
										value="{gp>/Remarks}"
										placeholder="Enter remarks..."
										rows="2"
										maxLength="100"
										showExceededText="true"
										editable="{gp>/editable}"
										class="gpmsFieldInput"
										width="100%"/>
								</VBox>
							</layout:Grid>
						</VBox>

						<!-- Right-Side Fields Container (3 columns out of 12) -->
						<VBox>
							<layoutData>
								<layout:GridData span="XL3 L3 M4 S12"/>
							</layoutData>
							<layout:Grid defaultSpan="XL12 L12 M12 S12" vSpacing="1" hSpacing="1" class="gpmsInnerGrid">
								<!-- Gatepass Number (Search Input) -->
								<VBox>
									<Label text="Gatepass Number" class="gpmsFieldLabel"/>
									<Input
										value="{gp>/GatePassNo}"
										editable="{= ${gp>/IsInward} &amp;&amp; ${gp>/editable} }"
										showValueHelp="{gp>/IsInward}"
										valueHelpRequest=".onGatePassNoChange"
										change=".onGatePassNoChange"
										class="gpmsFieldInput"
										width="100%"/>
								</VBox>

								<!-- Date -->
								<VBox>
									<Label text="Date" required="true" class="gpmsFieldLabel"/>
									<DatePicker
										id="gpDate"
										dateValue="{gp>/gpDate}"
										displayFormat="dd-MM-yyyy"
										editable="{gp>/editable}"
										class="gpmsFieldInput"
										width="100%"/>
								</VBox>
							</layout:Grid>
						</VBox>

					</layout:Grid>
				</Panel>

				<!-- ─── SECTION 3 · Item Information ──────────────────── -->
				<Panel class="gpmsSection" expandable="false">
					<headerToolbar>
						<Toolbar class="gpmsSectionBar">
							<core:Icon src="sap-icon://grid" class="gpmsSectionBarIcon"/>
							<Label text="Item Information" class="gpmsSectionBarLabel"/>
							<ToolbarSpacer/>
							<Button
								text="Add Row"
								icon="sap-icon://add"
								press=".onAddItem"
								visible="{gp>/editable}"
								class="gpmsAddBtn"/>
						</Toolbar>
					</headerToolbar>
					<Table
						id="itemsTable"
						items="{path: 'gp>/items', templateShareable: false}"
						noDataText="No items added."
						class="gpmsItemTable">
						<columns>
							<Column width="3rem" hAlign="Center">
								<Text text="SNo" class="gpmsHeaderText"/>
							</Column>

							<!-- Material SAP Code: hidden in Manual mode -->
							<Column width="11rem" visible="{= !${gp>/IsManual} }">
								<Text text="Material" class="gpmsHeaderText"/>
							</Column>

							<!-- Material Description: always visible -->
							<Column width="15rem">
								<Text text="Material Description" class="gpmsHeaderText"/>
							</Column>

							<Column width="7rem" hAlign="Right">
								<Text text="Qty" class="gpmsHeaderText"/>
							</Column>

							<Column width="7rem" hAlign="Right">
								<Text text="No. of Packs" class="gpmsHeaderText"/>
							</Column>

							<Column width="6rem" hAlign="Center">
								<Text text="UOM" class="gpmsHeaderText"/>
							</Column>

							<!-- Expected Returnable Date: Outward + RGP -->
							<Column width="11rem" visible="{= ${gp>/IsOutward} &amp;&amp; ${gp>/IsReturnable} }">
								<Text text="Expected Returnable Date" class="gpmsHeaderText"/>
							</Column>

							<!-- Received Qty: Inward + RGP only -->
							<Column width="7rem" hAlign="Right" visible="{= ${gp>/IsInward} &amp;&amp; ${gp>/IsReturnable} }">
								<Text text="Received Qty" class="gpmsHeaderText"/>
							</Column>

							<!-- Return Date: Inward + RGP only -->
							<Column width="11rem" visible="{= ${gp>/IsInward} &amp;&amp; ${gp>/IsReturnable} }">
								<Text text="Return Date" class="gpmsHeaderText"/>
							</Column>

							<!-- Rate / Amount hidden but kept for OData payload -->
							<Column width="7rem" hAlign="Right" visible="false">
								<Text text="Rate" class="gpmsHeaderText"/>
							</Column>
							<Column width="8rem" hAlign="Right" visible="false">
								<Text text="Amount" class="gpmsHeaderText"/>
							</Column>

							<Column width="4rem" hAlign="Center" visible="{gp>/editable}">
								<Text text="" class="gpmsHeaderText"/>
							</Column>
						</columns>
						<items>
							<ColumnListItem vAlign="Middle" class="gpmsItemRow">
								<cells>
									<Text text="{gp>sno}" class="gpmsSnoText"/>

									<!-- Material SAP Code -->
									<Input
										value="{gp>material}"
										showValueHelp="true"
										valueHelpRequest=".onMaterialValueHelp"
										change=".onMaterialInputChange"
										editable="{gp>/editable}"
										class="gpmsTableInput"
										width="100%"
										placeholder="F4..."/>

									<!-- Material Description -->
									<Input
										value="{gp>materialName}"
										editable="{gp>/editable}"
										class="gpmsTableInput"
										width="100%"
										placeholder="Enter description..."/>

									<Input
										value="{gp>quantity}"
										type="Number"
										textAlign="Right"
										editable="{gp>/editable}"
										liveChange=".onQtyRateChange"
										class="gpmsTableInput"/>

									<Input
										value="{gp>noOfPacks}"
										editable="{gp>/editable}"
										class="gpmsTableInput"
										placeholder="Packs..."/>

									<!-- UOM -->
									<Input
										value="{gp>uom}"
										editable="{gp>/editable}"
										class="gpmsTableInput"
										textAlign="Center"
										placeholder="UOM..."/>

									<DatePicker
										dateValue="{gp>expectedReturnableDate}"
										displayFormat="dd-MM-yyyy"
										editable="{gp>/editable}"
										class="gpmsTableInput"
										width="100%"/>

									<Input
										value="{gp>receivedQty}"
										type="Number"
										textAlign="Right"
										editable="{gp>/editable}"
										class="gpmsTableInput"/>

									<DatePicker
										dateValue="{gp>returnDate}"
										displayFormat="dd-MM-yyyy"
										editable="{gp>/editable}"
										class="gpmsTableInput"
										width="100%"/>

									<Input value="{gp>rate}" type="Number" textAlign="Right" liveChange=".onQtyRateChange" class="gpmsTableInput"/>
									<Text text="{gp>amount}" class="gpmsAmountText" width="100%"/>
									<Button icon="sap-icon://delete" type="Transparent" press=".onRemoveItem" class="gpmsDeleteBtn"/>
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</Panel>

			</VBox>
		</content>
		<footer>
			<OverflowToolbar class="gpmsFooterBar">
				<Button
					text="Back to List"
					icon="sap-icon://back"
					press=".onNavBackToList"
					class="gpmsClearBtn"
					visible="{= !${gp>/editable} }"/>
				<ToolbarSpacer/>
				<Button
					text="Clear All"
					icon="sap-icon://clear-all"
					press=".onClear"
					class="gpmsClearBtn"
					visible="{gp>/editable}"/>
				<Button
					text="Print Gate Pass"
					icon="sap-icon://print"
					press=".onPrint"
					type="Emphasized"
					class="gpmsSubmitBtn sapUiSmallMarginEnd"/>
				<Button
					text="Submit Gate Pass"
					icon="sap-icon://paper-plane"
					press=".onSubmit"
					class="gpmsSubmitBtn"
					visible="{gp>/editable}"/>
			</OverflowToolbar>
		</footer>
	</Page>
</mvc:View>
