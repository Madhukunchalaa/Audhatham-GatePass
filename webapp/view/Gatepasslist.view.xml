<mvc:View
    controllerName="zaudgpms.audhatham.com.controller.GatePassList"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core">

    <Page title="Gate Pass List">
        <subHeader>
            <Bar>
                <contentLeft>
                    <SearchField id="idGatePassSearchField" width="18rem"
                        placeholder="Search by Gate Pass No."
                        liveChange=".onSearchFieldLiveChange" />
                </contentLeft>
                <contentMiddle>
                    <Select id="idTypeFilterSelect" width="11rem" change=".onSelectFilterChange">
                        <core:Item key="" text="All Types" />
                        <core:Item key="NRGP" text="NRGP" />
                        <core:Item key="RGP" text="RGP" />
                    </Select>
                    <Select id="idDirectionFilterSelect" width="11rem" change=".onSelectFilterChange">
                        <core:Item key="" text="All Directions" />
                        <core:Item key="Inward" text="Inward" />
                        <core:Item key="Outward" text="Outward" />
                    </Select>
                </contentMiddle>
                <contentRight>
                    <Button icon="sap-icon://clear-filter" text="Reset" press=".onResetButtonPress" />
                </contentRight>
            </Bar>
        </subHeader>

        <content>
            <Table id="idItemsGatePassTable"
                items="{gatePassList>/items}"
                noDataText="No gate pass records found."
                growing="true"
                alternateRowColors="true"
                sticky="ColumnHeaders,HeaderToolbar">

                <headerToolbar>
                    <Toolbar>
                        <Title text="Gate Pass List" level="H3" />
                        <ToolbarSpacer />
                        <Text id="idItemCountText" text="" />
                    </Toolbar>
                </headerToolbar>

                <columns>
                    <Column width="10rem">
                        <Text text="Gate Pass No." />
                    </Column>
                    <Column width="6rem">
                        <Text text="Direction" />
                    </Column>
                    <Column width="6rem">
                        <Text text="Type" />
                    </Column>
                    <Column width="5rem">
                        <Text text="Plant" />
                    </Column>
                    <Column>
                        <Text text="Vendor Name" />
                    </Column>
                    <Column width="8rem">
                        <Text text="Date" />
                    </Column>
                    <Column width="8rem">
                        <Text text="Vehicle No." />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem type="Navigation" press=".onColumnListItemPress">
                        <cells>
                            <ObjectIdentifier title="{gatePassList>GatePassNo}" />
                            <Text text="{gatePassList>Direction}" />
                            <Text text="{gatePassList>GatePassType}" />
                            <Text text="{gatePassList>Plant}" />
                            <Text text="{gatePassList>VendorName}" />
                            <Text text="{gatePassList>GpDate}" />
                            <Text text="{gatePassList>VehicleNo}" />
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>
        </content>
    </Page>

</mvc:View>
