<mvc:View
	controllerName="zaudgpms.audhatham.com.controller.Home"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:core="sap.ui.core"
	height="100%">
	<Page title="Dashboard" class="gpmsDashboardPage" showHeader="false">
		<content>
			<VBox class="gpmsDashboardHero" alignItems="Center" justifyContent="Center">
				<VBox alignItems="Center" class="gpmsHeroTextContainer">
					<Title text="GATE PASS MANAGEMENT SYSTEM" level="H1" class="gpmsHeroTitle"/>
					<Text text="Industrial Logistics &amp; Security Control Dashboard" class="gpmsHeroSubTitle"/>
				</VBox>

				<HBox wrap="Wrap" justifyContent="Center" class="gpmsDashboardCardsContainer">
					<!-- Create Gate Pass Card -->
					<GenericTile class="gpmsDashCard createCard" press=".onPressCreateGatePass" header="CREATE GATE PASS" subheader="New Gate Pass Entry">
						<TileContent>
							<core:Icon src="sap-icon://add-document" class="gpmsCardIcon"/>
						</TileContent>
					</GenericTile>

					<!-- Gate Pass List Card -->
					<GenericTile class="gpmsDashCard listCard" press=".onPressGatePassList" header="GATE PASS LIST" subheader="View All Gate Passes">
						<TileContent>
							<core:Icon src="sap-icon://list" class="gpmsCardIcon"/>
						</TileContent>
					</GenericTile>
				</HBox>
			</VBox>
		</content>
	</Page>
</mvc:View>
